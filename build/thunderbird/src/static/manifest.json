{
  "manifest_version": 2,
  "name": "Zoom Button for Thunderbird (Redux+)",
  "version": "0.2.0",
  "description": "Fixed-width zoom extension with custom configuration options dashboard & one-handed mouse zooming.",
  "author": "MaccabeeY Addons",
  "homepage_url": "https://github.com/MaccabeeY/zoom-button-thunderbird-redux",
  "browser_specific_settings": {
    "gecko": {
      "id": "ZoomButton@maccabeey.addon",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_label": "Zoom",
    "default_title": "Zoom this message",
    "default_icon": "images/icon-32-bw-thin.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "images/icon-32-bw-thin.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "messagesRead",
    "scripting",
    "storage",
    "tabs"
  ]
}
